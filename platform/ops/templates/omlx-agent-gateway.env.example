# Non-secret runtime defaults for omlx-agent-gateway.
# Install as /etc/homelab-llm/omlx-agent-gateway.env on the Mini.
# Keep OMLX_AGENT_GATEWAY_AUTH_TOKEN and OMLX_AGENT_GATEWAY_BACKEND_API_KEY in
# /etc/homelab-llm/omlx-agent-gateway.secret.env.

OMLX_AGENT_GATEWAY_HOST=127.0.0.1
OMLX_AGENT_GATEWAY_PORT=4022
OMLX_AGENT_GATEWAY_MODEL_ID=omlx-qwen36-27b-optiq-4bit
OMLX_AGENT_GATEWAY_BACKEND_BASE_URL=http://192.168.1.72:8120/v1
OMLX_AGENT_GATEWAY_BACKEND_MODEL=omlx-qwen36-27b-optiq-4bit
OMLX_AGENT_GATEWAY_TIMEOUT_SECONDS=180
OMLX_AGENT_GATEWAY_MAX_INPUT_TOKENS=32768
OMLX_AGENT_GATEWAY_MAX_OUTPUT_TOKENS=32768
OTEL_SERVICE_NAME=omlx-agent-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=mini-local,service.namespace=homelab
OTEL_ATTRIBUTE_VALUE_LENGTH_LIMIT=16384
HOMELAB_OTEL_CONTENT_ATTRIBUTE_LIMIT_BYTES=16384
